  "rules": [
    {
      "name": "liability_cap_meets_floor",
      "message": "Liability cap in {obj.id} is below the playbook floor of 12 months of fees.",
      "plain": "Never: Liability cap in {id} is below the playbook floor of 12 months of fees.",
      "doc": "The walk-away floor: the cap must cover 12 months of fees.\n\nOrdering: at proposal time this rule sees only fee clauses already in\nthe graph, so a cap drafted against an empty fee schedule passes\nvacuously \u2014 and committed facts are immutable, so it could never be\nrepaired (a live agent found this wedge). Two layers close it: the\nengine re-checks committed caps differentially (a later fee that would\nflip this rule is itself rejected), and the companion rule below rejects\nthe cap-before-fees ordering outright \u2014 rejecting the actual mistake\nbeats rejecting the fee the deal memo requires. The caps_cover_fees goal\nbelow re-checks the floor at the output boundary as a belt-and-suspenders.",
      "severity": "reject",
      "target": "LiabilityCapClause"
    },
    {
      "name": "liability_cap_follows_fee_schedule",
      "message": "Liability cap {obj.id} was drafted before any fee clause \u2014 draft the fee schedule first, then cap liability against it.",
      "plain": "Never: Liability cap {id} was drafted before any fee clause \u2014 draft the fee schedule first, then cap liability against it.",
      "doc": null,
      "severity": "reject",
      "target": "LiabilityCapClause"
    },
    {
      "name": "fee_is_positive",
      "message": "Fee clause {obj.id} has a non-positive monthly fee.",
      "plain": "Never: Fee clause {id} has a non-positive monthly fee.",
      "doc": null,
      "severity": "reject",
      "target": "FeeClause"
    },
    {
      "name": "mfn_needs_counsel_review",
      "message": "MFN clause {obj.id} is allowed but requires counsel review before signature.",
      "plain": "Never: MFN clause {id} is allowed but requires counsel review before signature. (advisory: flagged, not rejected)",
      "doc": null,
      "severity": "flag",
      "target": "MFNClause"
    },
    {
      "name": "indemnitor_is_not_indemnitee",
      "message": "Indemnity clause {obj.id} names {obj.indemnitor} as both indemnitor and indemnitee.",
      "plain": "Never: Indemnity clause {id} names {indemnitor} as both indemnitor and indemnitee.",
      "doc": null,
      "severity": "reject",
      "target": "IndemnityClause"
    }
  ],
